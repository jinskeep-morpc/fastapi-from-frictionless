<% endif %>
<% for gf in geo_fields %>

    @field_serializer('<< gf >>')
    def serialize_<< gf >>(self, value):
        return geometry_to_geojson(value)
<% endfor %>

class << name >>(<< name >>Base, TimestampMixin, table=True):
<% if index_args %>
    __table_args__ = (<< index_args >>,)
<% endif %>
<% if auto_id %>
    id: int | None = Field(default=None, primary_key=True)
<% endif %>
<% if table_extra_str %>
    << table_extra_str >>
<% endif %>
<% for rel in rel_models %>
    << rel.attr >>: list['<< rel.name >>'] | None = Relationship(back_populates='<< rel.back_populates >>'<% if rel.fk_ref %>, sa_relationship_kwargs={'foreign_keys': '<< rel.fk_ref >>'}<% endif %>)
<% endfor %>
<% for fk in fk_models %>
    << fk.prefix >>: Optional['<< fk.related >>'] = Relationship(back_populates='<< fk.back_populates >>'<% if fk.fk_ref %>, sa_relationship_kwargs={'foreign_keys': '<< fk.fk_ref >>'}<% endif %>)
<% endfor %>
<% if not auto_id and not relationships and not foreign_keys %>
    pass
<% endif %>


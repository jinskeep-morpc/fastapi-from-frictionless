# .env.example — copy to .env and fill in values
# Start the stack: docker compose up -d   (or: podman-compose up -d)

# Deployment identity
PROJECT_NAME=my-project

# SUBNET_BASE must be unique per concurrent stack on this machine.
# Use 10.91, 10.92, 10.93, etc. for each project running simultaneously.
SUBNET_BASE=10.91

# Host port bindings — must be unique per concurrent stack on this machine.
# Example second project: API_PORT=8100, PGADMIN_PORT=8150, DB_PORT=8132
#
# BIND_ADDRESS controls which host interface the published ports listen on.
# The default, 127.0.0.1, keeps PostgreSQL, pgAdmin and the API reachable from
# this host only; put a reverse proxy, tunnel or VPN in front to expose them.
# Set it to 0.0.0.0 ONLY if you intend them on every interface - on a public
# host that means an open PostgreSQL port and a public pgAdmin console, and
# Docker's port rules bypass a host firewall, so closing the port in ufw or
# firewalld will not save you.
BIND_ADDRESS=127.0.0.1

API_PORT=8000
PGADMIN_PORT=5050
DB_PORT=5432

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=mydb

# pgAdmin credentials
PGADMIN_DEFAULT_EMAIL=you@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Schema folder (host-side path, relative to compose.yaml)
SCHEMA_FOLDER=schemas              # Folder containing your *.schema.yaml files

# API configuration
# Browser CRUD UI. WITH_UI is build-time: set it, then `docker compose build api`.
# SKIP_UI omits resources from the UI, e.g. a table too large to browse.
WITH_UI=                           # any non-empty value enables the UI at /ui
SKIP_UI=                           # space-separated resource names, e.g. "reading"

# Trust an identity header from a proxy in front (Cloudflare Access, Tailscale,
# oauth2-proxy) instead of the UI's own shared-key sign-in. Only set this where
# the proxy is the ONLY route to the app: anything that can reach it directly
# can forge the header.
UI_PROXY_IDENTITY_HEADER=

API_KEY=                           # Leave empty to disable API key authentication
ALLOWED_ORIGINS=*                  # Comma-separated CORS origins; use * for development
API_URL=http://localhost:8000      # Must match API_PORT
